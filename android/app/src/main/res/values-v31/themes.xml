<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen via AndroidX SplashScreen API (works on
         all minSdk 21+ versions thanks to the backport). -->
    <style name="Theme.SMC.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SMC</item>
    </style>
</resources>
